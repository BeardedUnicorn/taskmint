{
  "name": "records are saved, read back, and merged in without overwriting, each counting its revisions",
  "steps": [
    {
      "call": "get_app_records",
      "reply": {
        "records": {},
        "revisions": {
          "predefinedTasks": 0,
          "taskNotes": 0,
          "noteTemplates": 0,
          "dailyGoal": 0,
          "dailyGoalAchievements": 0,
          "withdrawals": 0
        }
      }
    },
    {
      "call": "set_app_record",
      "args": { "key": "dailyGoal", "value": { "targetAmount": 100 } },
      "reply": { "revision": 1 },
      "events": ["app-records-changed"]
    },
    {
      "call": "set_app_record",
      "args": { "key": "theme-mode", "value": "dark" },
      "error": "Unknown record \"theme-mode\""
    },
    {
      "call": "import_app_records",
      "args": {
        "records": {
          "dailyGoal": { "targetAmount": 5 },
          "taskNotes": [{ "id": "n1" }],
          "noteTemplates": null,
          "theme-mode": "dark"
        }
      },
      "reply": {
        "records": {
          "dailyGoal": { "targetAmount": 100 },
          "taskNotes": [{ "id": "n1" }],
          "noteTemplates": "$absent",
          "theme-mode": "$absent"
        },
        "revisions": { "dailyGoal": 1, "taskNotes": 1, "noteTemplates": 0 }
      },
      "events": ["app-records-changed"]
    },
    {
      "call": "import_app_records",
      "args": { "records": { "dailyGoal": { "targetAmount": 5 }, "theme-mode": "dark" } },
      "reply": {
        "records": { "dailyGoal": { "targetAmount": 100 } },
        "revisions": { "dailyGoal": 1 }
      }
    },
    {
      "call": "import_app_records",
      "args": { "records": { "theme-mode": "dark", "taskNotes": null } },
      "reply": { "records": { "dailyGoal": { "targetAmount": 100 } } }
    },
    {
      "call": "import_app_records",
      "args": { "records": { "taskNotes": [{ "id": "n1" }, { "id": "n2" }] } },
      "reply": {
        "records": { "taskNotes": [{ "id": "n1" }, { "id": "n2" }] },
        "revisions": { "taskNotes": 2 }
      },
      "events": ["app-records-changed"]
    },
    {
      "call": "set_app_record",
      "args": { "key": "dailyGoal", "value": { "targetAmount": 120 }, "baseRevision": 1 },
      "reply": { "revision": 2 },
      "events": ["app-records-changed"]
    },
    {
      "call": "set_app_record",
      "args": { "key": "dailyGoal", "value": { "targetAmount": 90 }, "baseRevision": 1 },
      "error": "This was changed on another device. Reload to see the latest."
    },
    {
      "call": "set_app_record",
      "args": { "key": "noteTemplates", "value": [], "baseRevision": 3 },
      "error": "This was changed on another device. Reload to see the latest."
    },
    {
      "call": "get_app_records",
      "reply": {
        "records": { "dailyGoal": { "targetAmount": 120 }, "noteTemplates": "$absent" },
        "revisions": { "dailyGoal": 2, "taskNotes": 2, "noteTemplates": 0 }
      }
    },
    {
      "reload": true,
      "call": "get_app_records",
      "reply": {
        "records": {
          "dailyGoal": { "targetAmount": 120 },
          "taskNotes": [{ "id": "n1" }, { "id": "n2" }]
        }
      },
      "save": { "goalRevision": "/revisions/dailyGoal" }
    },
    {
      "call": "set_app_record",
      "args": { "key": "dailyGoal", "value": null, "baseRevision": "$goalRevision" },
      "reply": { "revision": "$any" },
      "events": ["app-records-changed"]
    },
    {
      "call": "set_app_record",
      "args": {
        "key": "dailyGoal",
        "value": { "targetAmount": 1 },
        "baseRevision": "$goalRevision"
      },
      "error": "This was changed on another device. Reload to see the latest."
    },
    {
      "call": "import_app_records",
      "args": {},
      "error": "Invalid arguments for import_app_records: missing field `records`"
    },
    {
      "reload": true,
      "call": "get_app_records",
      "reply": {
        "records": { "dailyGoal": "$absent", "taskNotes": [{ "id": "n1" }, { "id": "n2" }] }
      }
    }
  ]
}
