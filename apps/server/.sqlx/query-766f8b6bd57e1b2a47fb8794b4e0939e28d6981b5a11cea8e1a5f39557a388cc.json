{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.username, u.display_name, u.role AS \"role: Role\", u.created_at,\n               u.disabled_at,\n               (SELECT max(s.last_seen_at) FROM auth_sessions s WHERE s.user_id = u.id)\n                   AS last_seen_at\n        FROM users u\n        ORDER BY u.username\n        ",
