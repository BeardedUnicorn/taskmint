<?xml version="1.0" encoding="utf-8"?>
<!-- TaskMint: a Calendar widget day at the middle of its week's card
     (the agenda's `position`), pressed like the card's other rows -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/widget_surface" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="1dp" android:left="12dp" android:right="12dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/widget_divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
