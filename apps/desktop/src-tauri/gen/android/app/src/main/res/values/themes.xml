<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.taskmint" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
    </style>

    <!-- TaskMint: the launch screen (androidx core-splashscreen), the leaf on
         the app icon's teal. MainActivity holds it until the page has drawn.
         Android 12 and later also show the wordmark (values-v31). -->
    <style name="Theme.taskmint.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/taskmint_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.taskmint</item>
    </style>
</resources>
