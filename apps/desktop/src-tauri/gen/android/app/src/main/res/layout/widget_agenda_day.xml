<?xml version="1.0" encoding="utf-8"?>
<!-- TaskMint: a day in the Calendar widget, as the phone's Calendar agenda
     shows it: the weekday and date (today circled), the time over the goal
     bar, the money, and the day's badges. Its background rounds it into its
     week's card (CalendarViews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_day"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_day_single"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_weekday"
                style="@style/TaskMintWidget.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/day_weekday_today"
                style="@style/TaskMintWidget.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:textColor="@color/widget_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/day_number"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/day_number_today"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_today_circle"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textColor="@color/widget_button_text"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/day_time_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_time"
                style="@style/TaskMintWidget.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum" />

            <ProgressBar
                android:id="@+id/day_goal"
                style="@style/TaskMintWidget.Goal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/day_goal_met"
                style="@style/TaskMintWidget.Goal.Met"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Takes the time's place when there's no room for it -->
        <FrameLayout
            android:id="@+id/day_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/day_money"
            style="@style/TaskMintWidget.Figure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/day_badges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

            <TextView
                android:id="@+id/badge_0_info"
                style="@style/TaskMintWidget.Badge.Info" />
            <TextView
                android:id="@+id/badge_0_success"
                style="@style/TaskMintWidget.Badge.Success" />
            <TextView
                android:id="@+id/badge_1_info"
                style="@style/TaskMintWidget.Badge.Info" />
            <TextView
                android:id="@+id/badge_1_success"
                style="@style/TaskMintWidget.Badge.Success" />
            <TextView
                android:id="@+id/badge_2_info"
                style="@style/TaskMintWidget.Badge.Info" />
            <TextView
                android:id="@+id/badge_2_success"
                style="@style/TaskMintWidget.Badge.Success" />
    </LinearLayout>
</LinearLayout>
