<?xml version="1.0" encoding="utf-8"?>
<!-- TaskMint: the Calendar widget (the widget picker's preview: sample figures, no "as of") -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_stat_taskmint"
            android:tint="@color/widget_accent" />

        <TextView
            style="@style/TaskMintWidget.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Calendar" />
        <TextView
            style="@style/TaskMintWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="November · ~$1,240" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/TaskMintWidget.Overline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Week of Nov 8" />
        <TextView
            style="@style/TaskMintWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="6h 15m · ~$187" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_day_top"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">
    
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
    
            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">
    
                <TextView
                    style="@style/TaskMintWidget.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="Thu" />
    
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/widget_text"
                    android:text="12"
                    android:textSize="15sp" />
            </LinearLayout>
    
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
    
                <TextView
                    style="@style/TaskMintWidget.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h 10m" />
    
                <ProgressBar
                    style="@style/TaskMintWidget.Goal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:progress="65" />
            </LinearLayout>
    
            <TextView
                style="@style/TaskMintWidget.Figure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="~$65"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />
        </LinearLayout>
    
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_day_bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">
    
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
    
            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">
    
                <TextView
                    style="@style/TaskMintWidget.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:textColor="@color/widget_accent"
                    android:text="Fri" />
    
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:background="@drawable/widget_today_circle"
                    android:textColor="@color/widget_button_text"
                    android:text="13"
                    android:textSize="15sp" />
            </LinearLayout>
    
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
    
                <TextView
                    style="@style/TaskMintWidget.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4h 5m" />
    
                <ProgressBar
                    style="@style/TaskMintWidget.Goal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:progress="100" />
            </LinearLayout>
    
            <TextView
                style="@style/TaskMintWidget.Figure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="~$122"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />
        </LinearLayout>
    
        <TextView
            style="@style/TaskMintWidget.Badge.Success"
            android:layout_marginStart="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_badge_success_ahead"
            android:drawableStart="@drawable/ic_widget_schedule"
            android:text="6:25 PM"
            android:visibility="visible" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/TaskMintWidget.Overline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Week of Nov 15" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_day_single"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">
    
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
    
            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">
    
                <TextView
                    style="@style/TaskMintWidget.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="Fri" />
    
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/widget_text"
                    android:text="20"
                    android:textSize="15sp" />
            </LinearLayout>
    
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    
        <TextView
            style="@style/TaskMintWidget.Badge.Info"
            android:layout_marginStart="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_badge_info_ahead"
            android:drawableStart="@drawable/ic_widget_release"
            android:text="~$230"
            android:visibility="visible" />
    </LinearLayout>
</LinearLayout>
