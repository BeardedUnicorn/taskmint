<?xml version="1.0" encoding="utf-8"?>
<!-- TaskMint: the Calendar widget (CalendarViews): the phone's Calendar
     agenda as a list, weeks (widget_agenda_week) and their days
     (widget_agenda_day), opened at this week -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_card_ripple"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="@dimen/widget_padding"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <include layout="@layout/widget_header" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/agenda_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/agenda_empty"
            style="@style/TaskMintWidget.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="4dp"
            android:text="@string/widget_nothing_tracked"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_message"
        style="@style/TaskMintWidget.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:maxLines="3"
        android:text="@string/widget_open_app"
        android:textColor="@color/widget_text_secondary"
        android:visibility="gone" />
</LinearLayout>
