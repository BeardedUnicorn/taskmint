<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- TaskMint: values/themes.xml's launch screen, with the wordmark at the
         bottom (the branding slot is Android 12's; the compat library has
         none before it) -->
    <style name="Theme.taskmint.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/taskmint_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.taskmint</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
