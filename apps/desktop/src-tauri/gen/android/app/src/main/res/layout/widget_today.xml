<?xml version="1.0" encoding="utf-8"?>
<!-- TaskMint: the Today widget, two rows and more, with no timer running
     (TodayViews; widget_today_running while one runs): today's money and
     time, the goal, this week when tall, and the timer card at the bottom
     with Start, or the paused timer with Resume. Also the widget's layout
     until its first draw, so its texts are empty. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_card_ripple"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <include layout="@layout/widget_header" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/today_money"
                style="@style/TaskMintWidget.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/today_time"
                style="@style/TaskMintWidget.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- The time under the money, where there's no room beside it -->
        <TextView
            android:id="@+id/today_time_under"
            style="@style/TaskMintWidget.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/goal_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/goal_bar"
                style="@style/TaskMintWidget.Goal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/goal_bar_met"
                style="@style/TaskMintWidget.Goal.Met"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/goal_text"
                style="@style/TaskMintWidget.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Tall: the height to spare split around this week -->
        <FrameLayout
            android:id="@+id/week_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/week_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/TaskMintWidget.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_week_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/week_money"
                    style="@style/TaskMintWidget.Figure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/week_time"
                    style="@style/TaskMintWidget.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Whatever height is to spare, so the timer card sits at the bottom -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <LinearLayout
            android:id="@+id/timer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_inner"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timer_task"
                    style="@style/TaskMintWidget.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/timer_status"
                    style="@style/TaskMintWidget.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/timer_button"
                style="@style/TaskMintWidget.Button"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/timer_icon_button"
                style="@style/TaskMintWidget.IconButton"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_widget_play"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_message"
        style="@style/TaskMintWidget.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:text="@string/widget_open_app"
        android:textColor="@color/widget_text_secondary"
        android:visibility="gone" />
</LinearLayout>
