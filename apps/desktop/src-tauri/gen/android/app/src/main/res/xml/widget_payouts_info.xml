<?xml version="1.0" encoding="utf-8"?>
<!-- TaskMint: the Payouts widget (PayoutsWidget). Redrawn every 30 minutes,
     which turns "Opens …" to "Withdrawal open" once its time has passed. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_payouts_description"
    android:initialLayout="@layout/widget_payouts"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_payouts"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
