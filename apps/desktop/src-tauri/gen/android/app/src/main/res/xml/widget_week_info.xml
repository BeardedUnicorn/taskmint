<?xml version="1.0" encoding="utf-8"?>
<!-- TaskMint: the This week widget (WeekWidget), from two rows up. Redrawn as the
     page sends new figures, at midnight and when the next withdrawal opens
     (Widgets.scheduleRefresh), so it never polls. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_week_description"
    android:initialLayout="@layout/widget_week"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_week_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
