<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A scheduled withdrawal's reminder fires at its exact time (the
         notification plugin falls back to an inexact alarm without these).
         USE_EXACT_ALARM is granted at install from Android 13; Android 12
         needs SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- and is set again after the phone restarts (RemindersRestore) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The running timer's notification asks to be a Live Update (Android
         16 and later): its time then also counts in the status bar
         (TimerNotice.kt) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Whether Advanced Protection is on (Android 16 and later): it blocks
         installing an update from outside the Play Store, and the update
         dialog says so (MainActivity's installsBlocked) -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <!-- The app downloads its own update and opens Android's installer on
         it (AppUpdate.kt); Android asks the user to allow that the first time -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.taskmint"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- TaskMint: a dev build (TASKMINT_ENV, app/build.gradle.kts) never
             collects Analytics -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="${analyticsDeactivated}" />
        <!-- TaskMint: portrait only. A phone turned sideways is wider than the
             phone layout (600px) and too short for the desktop one. Android
             16 and later still rotate it on a tablet-sized screen, which gets
             the desktop layout. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:theme="@style/Theme.taskmint.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TaskMint: the home-screen widgets (Widgets.kt) -->
        <receiver
            android:name=".TodayWidget"
            android:exported="false"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".PayoutsWidget"
            android:exported="false"
            android:label="@string/widget_payouts_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_payouts_info" />
        </receiver>
        <receiver
            android:name=".CalendarWidget"
            android:exported="false"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>
        <receiver
            android:name=".WeekWidget"
            android:exported="false"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <!-- and redrawing them at midnight, when the next withdrawal opens,
             and when the phone's clock or time zone changes -->
        <receiver android:name=".WidgetRefresh" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- TaskMint: the message that another device published the widgets'
             figures (WidgetPush.kt). The phone has a push address only while
             it syncs with an account (WidgetSync turns it on and off). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Messages are sent to the Firebase installation ID (registration
             tokens are deprecated) -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <service android:name=".WidgetPush" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- TaskMint: its reminders' alarms (Reminders.kt), and setting
             them again once the phone has started and been unlocked, or
             TaskMint was updated. Not LOCKED_BOOT_COMPLETED: the reminders
             are kept in storage that opens at the unlock, and one that came
             due before then shows at the unlock. -->
        <receiver android:name=".ReminderAlarm" android:exported="false" />
        <receiver android:name=".RemindersRestore" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
