<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TaskMint: the launch screen's background, the app icon's teal -->
    <color name="taskmint_splash">#FF0A3A3E</color>

    <!-- The widgets and shortcut icons, in light mode (values-night: dark),
         as the app's own palettes have them (packages/client theme). Text
         reads at 4.5:1 or more on the card and the inner card, bars at 3:1. -->
    <color name="widget_background">#FFFFFFFF</color>
    <!-- An inner card (the timer, a week's days, the bars' track) -->
    <color name="widget_surface">#FFEEF6F2</color>
    <color name="widget_divider">#1F000000</color>
    <color name="widget_ripple">#1F000000</color>
    <color name="widget_text">#FF3F4E4F</color>
    <color name="widget_text_secondary">#FF616161</color>
    <color name="widget_accent">#FF1F6F4A</color>
    <color name="widget_track">#FFE0E0E0</color>
    <!-- A day's bar in the week chart; today's is widget_accent -->
    <color name="widget_bar">#FF3F9A70</color>
    <!-- The Calendar's badges: money released (info), withdrawals and the opening (success) -->
    <color name="widget_info_text">#FF01579B</color>
    <color name="widget_info_tint">#240277BD</color>
    <color name="widget_info_line">#B30277BD</color>
    <!-- A goal met -->
    <color name="widget_success">#FF2E7D32</color>
    <color name="widget_success_text">#FF1B5E20</color>
    <color name="widget_success_tint">#242E7D32</color>
    <color name="widget_success_line">#B32E7D32</color>
    <!-- The brand green button, with the teal's text on it (both modes) -->
    <color name="widget_button">#FF65D6A1</color>
    <color name="widget_button_text">#FF0A3A3E</color>
    <color name="widget_button_ripple">#330A3A3E</color>
</resources>
