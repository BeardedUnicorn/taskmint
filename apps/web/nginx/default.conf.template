# The web app's files, and /api passed to the TaskMint server
# (${TASKMINT_SERVER}). The browser sees one origin, so the API needs no CORS.
# Invite and reset links carry their secret in the path, the page's and its
# API calls': the access log keeps those paths with the secret replaced, and
# leaves out the Referer, which would repeat it.
map $request_uri $logged_uri {
    "~^(?<link>/(?:invite|reset|api/v1/invites|api/v1/password-resets)/)[^/?]+(?<rest>.*)$" "$link[redacted]$rest";
    default $request_uri;
}
log_format taskmint '$remote_addr - $remote_user [$time_local] "$request_method $logged_uri $server_protocol" '
                    '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /var/log/nginx/access.log taskmint;

    # Restore and import payloads (the server's own limit is 32 MB)
    client_max_body_size 32m;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The event stream: unbuffered, and held open between events (the server
    # sends a keep-alive every 15 seconds)
    location = /api/v1/events {
        proxy_pass ${TASKMINT_SERVER};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The server sends it too; the snippet's is the one kept
        proxy_hide_header X-Content-Type-Options;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass ${TASKMINT_SERVER};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Content-Type-Options;
    }

    # Built files are named by their content
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Every other path is the app (its own pages: /login, /invite/…, /reset/…)
    location / {
        add_header Cache-Control no-cache;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
