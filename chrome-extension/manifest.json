{
  "manifest_version": 3,
  "name": "TaskMint Work-Log Capture",
  "version": "0.1.0",
  "description": "Captures the DataAnnotation payments work-log payload and delivers it to the TaskMint desktop app.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TaskMint capture: waiting for the DataAnnotation payments page"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.dataannotation.tech/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.dataannotation.tech/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:43117/*"]
}
