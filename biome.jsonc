// Formatting and lint for the TypeScript and JavaScript (`pnpm lint`,
// `pnpm lint:fix`; .githooks/pre-commit checks staged files). Rust has
// rustfmt and clippy, and JSON, CSS and Markdown keep their hand layout.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!target",
      // The Rust crates' trees (fixtures and scenarios are test data)
      "!apps/desktop/src-tauri",
      "!crates",
      // wasm-bindgen's output (scripts/build-wasm.mjs)
      "!apps/web/src/wasm",
      // Generated from crates/taskmint-core; scripts/check-contracts.sh
      // compares it byte for byte with what the Rust generates
      "!packages/contracts/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true
    }
  },
  // Import sorting would reorder every file's imports
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // tsc (isolatedModules) already flags the imports that must be
        // type-only; rewriting the rest is churn with no effect on the build
        "useImportType": "off",
        // Used where tsc can't see an invariant the code checks (and in tests)
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // tsc --strict is the type gate. The remaining `any` are loose on
        // purpose: note field values, test fakes that return anything,
        // Sentry context
        "noExplicitAny": "off",
        // Flags `forEach(item => fn(item))`, whose return value forEach ignores
        "useIterableCallbackReturn": "off"
      },
      "complexity": {
        // Constructor mocks (vi.fn(function () { … })) must be functions so
        // `new` works; the arrow-function fix breaks them
        "useArrowFunction": "off"
      },
      // Nursery rules that catch real bugs: comparisons and arithmetic that
      // can't mean what they say, out-of-range toFixed/toString arguments,
      // errors made but not thrown, Map lookups on the wrong key, and promise
      // misuse. Nursery rules can change between Biome releases; Biome's
      // version is pinned, so a bump that changes them shows up in its own PR.
      // (Not noReturnArrayPush: it flags `x => list.push(x)` callbacks, whose
      // return value nothing reads.)
      "nursery": {
        "noArrayMethodsOnArguments": "error",
        "noAwaitInPromiseMethods": "error",
        "noChainedComparison": "error",
        "noConstantComparisons": "error",
        "noErasingOperation": "error",
        "noMismatchedMapKey": "error",
        "noMissingThrow": "error",
        "noNumberArgumentOutOfRange": "error",
        "noObjectLiteralComparison": "error",
        "noSinglePromiseInPromiseMethods": "error",
        "noUninvokedArrayCallback": "error",
        "noUselessAwait": "error"
      }
    }
  },
  "overrides": [
    {
      // Test doubles render bare elements in place of the real components
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
