# Copy this file to .env and fill in what you use.

# Sentry error reporting (optional). Leave as-is to disable reporting.
VITE_SENTRY_DSN=your_sentry_dsn_here

# --- Local server stack (docker compose; see README "Server") ---

# Postgres for the `db` service, published on 127.0.0.1:DB_PORT (5433, as a
# local Postgres often has 5432). The server tests connect to it too.
POSTGRES_PASSWORD=taskmint
DB_PORT=5433

# The server, published on 127.0.0.1:SERVER_PORT.
SERVER_PORT=3000

# Where people open the web app: invite and reset links start with it, and
# it's the origin trusted by the CSRF check.
PUBLIC_ORIGIN=http://localhost:8080

# Plain HTTP locally, so no Secure cookie. Use true behind HTTPS.
COOKIE_SECURE=false

# true when a reverse proxy in front of the server sets X-Forwarded-For (the
# web app's nginx does).
TRUST_PROXY=true

# The web app, published on 127.0.0.1:WEB_PORT. PUBLIC_ORIGIN should match.
WEB_PORT=8080

# The first admin, created when the server starts with no users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Server logs: a RUST_LOG filter, and text or json.
RUST_LOG=info
LOG_FORMAT=json
