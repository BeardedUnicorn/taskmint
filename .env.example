# Copy this file to .env and fill in what you use.

# Sentry error reporting (optional). Leave as-is to disable reporting.
VITE_SENTRY_DSN=your_sentry_dsn_here

# Google sign-in on the desktop (optional): the "Desktop app" OAuth client in
# Google Cloud console → APIs & Services → Credentials, project taskmint-f9a05.
# Without them, the desktop signs in to cloud sync by email and password.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Development builds only: sync with the Firebase emulators on this host
# (`pnpm firebase emulators:start`; 10.0.2.2 from the Android emulator).
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
