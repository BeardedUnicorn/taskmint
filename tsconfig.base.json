// Compiler options shared by every TypeScript package.
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // Every runtime we ship to (the desktop webview, current browsers,
    // Node 24, Chrome 120+) has ES2022's built-ins, like Array.prototype.at.
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true
  }
}
