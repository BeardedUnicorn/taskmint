{
  "name": "@taskmint/client",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "exports": {
    "./start": "./src/start.tsx",
    "./backend": "./src/backend/index.ts",
    "./testing": "./src/testing/index.ts",
    "./ui": "./src/ui.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude src/__tests__/integration/",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:sessions": "vitest run src/hooks/__tests__/useSessionManagement.test.ts",
    "test:session-system": "vitest run src/__tests__/integration/SessionSystem.integration.test.tsx"
  },
  "dependencies": {
    "@emotion/react": "catalog:",
