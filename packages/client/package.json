    "@fontsource/roboto-mono": "^5.3.0",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "@mui/x-date-pickers": "^9.11.0",
    "@sentry/react": "^10.70.0",
    "@taskmint/contracts": "workspace:*",
    "dayjs": "^1.11.23",
    "react": "catalog:",
    "react-big-calendar": "^1.20.0",
    "react-dom": "catalog:",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
