          );
        }}
        freeSolo
        disabled={disabled}
        renderInput={(params) => (
          <TextField
            {...params}
            label="Task"
            placeholder={placeholder}
            error={error}
            helperText={helperText}
            fullWidth
          />
        )}
      />
      
      {onCreateNewTask && (
        <Button
          variant="outlined"
          startIcon={<AddIcon />}
          onClick={() => setShowNewTaskInput(true)}
          size="small"
          disabled={disabled}
        >
          Create New Task
        </Button>
      )}
    </Stack>
