                    ))}
                  </Alert>
                )}
              </Box>
            )}

            {!isLoading && !migrationResult && (
              <Alert severity="info">
                <Typography variant="body2">
                  Ready to start migration. Click "Start Migration" to begin the process.
                </Typography>
              </Alert>
            )}
