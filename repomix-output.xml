      case 'prev':
        return 'Previous';
      case 'next':
        return 'Next';
      case 'today':
        return 'Today';
      default:
        return '';
    }
  };

  const displayLabel = label || getDefaultLabel();
  const icon = getIcon();

  return (
    <Button
      onClick={onClick}
      disabled={disabled}
      size={size}
      variant="outlined"
      startIcon={direction === 'prev' || direction === 'today' ? icon : undefined}
      endIcon={direction === 'next' ? icon : undefined}
      sx={{
        minWidth: direction === 'today' ? 140 : 'auto',
        ...sx,
      }}
    >
      {displayLabel}
    </Button>
  );
}
