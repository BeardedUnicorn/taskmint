        bgcolor: isRunning ? 'success.dark' : instance.isPaused ? 'warning.dark' : 'secondary.dark',
        color: 'white',
        minWidth: 120,
        transition: 'background-color 0.3s ease, transform 0.2s ease',
        '&:hover': {
          transform: 'translateY(-2px)',
          boxShadow: 2,
        },
