    let mut total_duration_ms = 0u64;
    let task_count = time_entries.len();

    for entry in time_entries {
        if let Some(duration) = entry.get("duration").and_then(|d| d.as_u64()) {
            total_duration_ms += duration;
        }
    }

    Ok(DailyTotal {
        total_duration_ms,
        task_count,
    })
}
