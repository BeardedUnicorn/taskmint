        }
        setAccess({ hasAccess: false, reason: 'Failed to check feature access' });
      } finally {
        setIsLoading(false);
      }
    };

    checkAccess();
  }, [feature, hasFeatureAccess]);

  return { ...access, isLoading };
}

export function useTaskLimit(currentTasks: Task[]) {
