  onStop: () => void;
  onPause: () => void;
  onResume: () => void;
  onOpenNotes?: () => void;
}

const TimerInstanceCard = memo(function TimerInstanceCard({
  instance,
  index,
  isRunning,
  elapsed,
  onStart,
  onStop,
  onPause,
  onResume,
  onOpenNotes,
}: TimerInstanceCardProps) {
  return (
    <Box
      component="section"
      tabIndex={0}
      role="region"
      aria-label={`Timer ${index}: ${isRunning ? 'running' : instance.isPaused ? 'paused' : 'stopped'}`}
      sx={{
