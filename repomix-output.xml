use serde::Deserialize;
use std::env;
use std::fs;
use std::path::Path;

#[derive(Debug, Deserialize)]
struct TrayConfig {
    status_update_interval: u64,
    menu_refresh_interval: u64,
    tooltip_app_name: String,
    max_recent_tasks: usize,
}

#[derive(Debug, Deserialize)]
struct RetryConfig {
