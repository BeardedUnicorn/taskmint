interface ErrorBoundaryState {
  hasError: boolean;
  error?: Error;
  errorInfo?: ErrorInfo;
  showDetails: boolean;
  isRecovering: boolean;
  recoveryAttempts: number;
  maxRecoveryAttempts: number;
