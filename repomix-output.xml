    setSettings(prev => ({
      ...prev,
      ...newSettings,
    }));
  };

  const resetToDefaults = () => {
    setSettings(DEFAULT_ENHANCED_TIMER_SETTINGS);
  };

  return {
    settings,
    roundingOption: settings.roundingOption,
    inactivitySettings: settings.inactivity,
    updateRoundingOption,
    updateInactivitySettings,
