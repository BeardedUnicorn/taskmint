                    </Typography>
                  </Box>
                }
              />

              {!localSettings.resumeOnActivity && (
                <Alert severity="info" sx={{ mt: 1 }}>
                  <Typography variant="body2">
                    <strong>Recommended:</strong> Keep this disabled for safety. 
