      const unknownTask = result.find(task => task.taskName === 'Unknown Task');
      expect(unknownTask).toBeDefined();
      expect(unknownTask!.totalEarnings).toBe(0); // Task not found in tasks array
    });

    it('should handle empty arrays', () => {
