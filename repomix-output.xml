      command: type === 'command' ? '' : undefined,
      options: type === 'select' ? [{ label: 'Option 1', value: 'option1' }] : undefined,
    };
    handleFieldUpdate(updates);
  }, [handleFieldUpdate]);

  const handleRequiredChange = useCallback((required: boolean) => {
    handleFieldUpdate({ required });
  }, [handleFieldUpdate]);

