            >
              <DeleteIcon />
            </IconButton>
          </Stack>
        </Box>
      )}

      <TableContainer sx={{ maxHeight }}>
        <Table stickyHeader size="small">
          <TableHead>
            <TableRow>
              {showBulkActions && (
