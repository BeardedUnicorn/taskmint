test.describe('Inactivity Settings Integration', () => {
  test('should respect custom inactivity threshold', async ({ page }) => {
    // Set longer threshold
    const customThreshold = 20; // 20 seconds
    
    await page.goto('/');
    await page.evaluate((threshold) => {
      const settings = {
        inactivityDetection: {
