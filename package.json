{
  "name": "taskmint-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "test:rules": "scripts/test-rules.sh",
    "firebase": "npx --yes firebase-tools@15.35.0",
    "dev": "pnpm --filter @taskmint/desktop dev",
    "tauri": "pnpm --filter @taskmint/desktop tauri",
    "check:coverage-policy": "node scripts/check-coverage-policy.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepare": "node scripts/install-hooks.mjs",
    "verify": "scripts/verify.sh",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
